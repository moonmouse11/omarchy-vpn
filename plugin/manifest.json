{
  "schemaVersion": 1,
  "id": "omarchy-vpn",
  "name": "VPN",
  "version": "0.2.0",
  "author": "omarchy-vpn",
  "license": "MIT",
  "description": "VPN status and menu: WireGuard, AmneziaWG, OpenVPN, NetworkManager, Happ and VLESS/Shadowsocks keys.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "VPN",
    "description": "Active VPN connection; click for the protection panel, right click for the VPN menu.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "interval": 3,
      "showLabel": true
    },
    "schema": [
      {
        "key": "interval",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show the connection name",
        "defaultValue": true
      }
    ]
  }
}
