#!/usr/bin/env bash
# omarchy-vpn-helper — omarchy-vpn's root entry point for WireGuard, AmneziaWG and
# OpenVPN. The sudoers rule grants NOPASSWD only this, happ-killswitch and four
# fixed sysctl calls; it used to grant `wg-quick *`, `cp * /etc/wireguard/*`,
# `cat /etc/wireguard/*`, `kill` and `openvpn --config *` — each one root for any
# process running as the user (a PostUp line, `cp x /etc/wireguard/../sudoers.d/`,
# any PID, any private key).
#
# Profile names only, never paths — the helper finds the files itself:
#   omarchy-vpn-helper up KIND NAME               KIND: wg | awg | ovpn
#   omarchy-vpn-helper down KIND NAME             (wg/awg: the interface name)
#   omarchy-vpn-helper import KIND NAME < CONFIG  refuses WireGuard hooks and
#                                                 OpenVPN directives off OVPN_SAFE
#   omarchy-vpn-helper rm KIND NAME               wg | awg
#   omarchy-vpn-helper autostart KIND NAME on|off wg | awg
#   omarchy-vpn-helper endpoints KIND NAME        only the Endpoint / remote lines
#   omarchy-vpn-helper audit                      profiles already on disk that
#                                                 would run commands as root (make install)
#   omarchy-vpn-helper ipv6-boot on|off           IPv6 off before an autostarted wg/awg
#                                                 tunnel comes up at boot (⚙ IPv6 guard)
#
# Installed root-owned to /usr/local/bin by omarchy-vpn's install.sh.
set -euo pipefail

# Test overrides (the directories, a dry run that prints commands). Ignored
# under sudo, which is how the plugin runs it — a caller must never point root
# at files of its own. (sudo's env_reset strips them anyway; this is belt and braces.)
if [[ -n ${SUDO_USER:-} ]]; then
    unset WG_DIR AWG_DIR OVPN_DIR PID_DIR PROC_DIR SYSTEMD_DIR SYSTEMCTL DRY_RUN
fi
WG_DIR=${WG_DIR:-/etc/wireguard}
AWG_DIR=${AWG_DIR:-/etc/amnezia/amneziawg}
OVPN_DIR=${OVPN_DIR:-/etc/openvpn/client}
PID_DIR=${PID_DIR:-/run/openvpn}
PROC_DIR=${PROC_DIR:-/proc}
SYSTEMD_DIR=${SYSTEMD_DIR:-/etc/systemd/system}
SYSTEMCTL=${SYSTEMCTL:-systemctl}
DROPIN=omarchy-vpn-ipv6.conf
DNS_UPDOWN=/usr/local/bin/openvpn-dns-updown
MAX_IMPORT=1048576  # 1 MiB — a config, not a disk filler

# WireGuard hooks run as root on `wg-quick up` (the same refusal as
# limehawk/omarchy-vpn's helper; NetworkManager drops them on import instead).
WG_HOOKS='^[[:space:]]*(PreUp|PostUp|PreDown|PostDown)[[:space:]]*='
# OpenVPN: an allowlist of client directives, never a denylist — openvpn also
# reads `--up`, `"up"` and `setenv opt up` as `up` (checked on 2.7.8), and new
# releases add new ways to run code as root (2.7's dns-updown). Anything not
# here is refused: scripts (it runs with --script-security 2), plugins and
# OpenSSL providers (.so), file writes, a management port, another config,
# `setenv NAME` (the root dns script's environment: LD_PRELOAD, PATH).
OVPN_SAFE='client tls-client pull dev dev-type proto port rport lport bind nobind
remote remote-random remote-random-hostname resolv-retry connect-retry
connect-retry-max connect-timeout server-poll-timeout explicit-exit-notify
float persist-key persist-tun persist-remote-ip persist-local-ip
ca cert key pkcs12 extra-certs tls-auth tls-crypt tls-crypt-v2 key-direction
tls-timeout tls-exit replay-window topology nice
route-ipv6 ifconfig-ipv6 block-ipv6 redirect-private
remote-cert-tls remote-cert-ku remote-cert-eku verify-x509-name ns-cert-type
tls-version-min tls-version-max tls-cipher tls-ciphersuites tls-groups
tls-cert-profile ecdh-curve cipher data-ciphers data-ciphers-fallback ncp-ciphers
auth auth-nocache auth-retry auth-user-pass static-challenge reneg-sec hand-window
comp-lzo compress allow-compression redirect-gateway route route-nopull
route-metric route-delay route-method dhcp-option block-outside-dns
pull-filter ifconfig-nowarn tun-mtu tun-mtu-extra link-mtu mssfix fragment
mtu-disc sndbuf rcvbuf fast-io ping ping-restart ping-exit ping-timer-rem keepalive
inactive verb mute mute-replay-warnings suppress-timestamps push-peer-info
ignore-unknown-option setenv-safe tun-ipv6 down-pre allow-pull-fqdn
machine-readable-output'
# Left out on purpose: http-proxy/socks-proxy (an auth file root would read
# and send to the proxy), user/group (the dns script's revert needs root).
# inline <tag> blocks that are data (keys, certs, credentials); <connection>
# holds directives and is checked line by line
OVPN_DATA_BLOCKS='ca cert key pkcs12 extra-certs tls-auth tls-crypt tls-crypt-v2 auth-user-pass'

die() { echo "error: $*" >&2; exit 1; }

run() {
    if [[ -n ${DRY_RUN:-} ]]; then
        echo "$*"
    else
        "$@"
    fi
}

# No "/" ever, no leading "-" (an option to wg-quick/systemctl) or "." ("..");
# dots inside stay allowed: provider OpenVPN files are often host.name_udp.ovpn.
check_name() {
    [[ $1 =~ ^[A-Za-z0-9_][A-Za-z0-9_.=+-]{0,63}$ ]] || die "invalid profile name: ${1@Q}"
}

dir_of() {
    case $1 in
        wg)   echo "$WG_DIR" ;;
        awg)  echo "$AWG_DIR" ;;
        ovpn) echo "$OVPN_DIR" ;;
        *)    die "unknown kind: ${1@Q} (wg | awg | ovpn)" ;;
    esac
}

# The profile's config file; empty when there is none.
conf_of() {
    local dir
    dir=$(dir_of "$1")
    if [[ $1 == ovpn && ! -f $dir/$2.conf && -f $dir/$2.ovpn ]]; then
        echo "$dir/$2.ovpn"
    elif [[ -f $dir/$2.conf ]]; then
        echo "$dir/$2.conf"
    fi
}

need_conf() {
    local conf
    conf=$(conf_of "$1" "$2")
    [[ -n $conf ]] || die "no $1 profile named ${2@Q}"
    echo "$conf"
}

# The first line that would run a command (or write a file) as root; empty if none.
unsafe_line() {
    if [[ $1 == ovpn ]]; then
        ovpn_unsafe_line "$2"
        return
    fi
    # sed, not xargs, to trim: xargs fails on an odd quote (`echo don't`) and
    # an empty answer here would wave the config through
    grep -Ei "$WG_HOOKS" "$2" | head -1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || true
}

# The first OpenVPN line whose directive isn't in OVPN_SAFE. A quoted or
# escaped directive never matches a name, so it is refused, not parsed.
# Where openvpn and awk could read a line differently, the line is refused:
# a block end with more on its line, a line of 256+ bytes (openvpn reads
# OPTION_LINE_SIZE pieces), a remote that `endpoints` wouldn't see.
ovpn_unsafe_line() {
    LC_ALL=C awk -v safe="$OVPN_SAFE" -v data="$OVPN_DATA_BLOCKS" '
        BEGIN {
            n = split(safe, s); for (i = 1; i <= n; i++) ok[s[i]] = 1
            n = split(data, s); for (i = 1; i <= n; i++) isdata[s[i]] = 1
        }
        function bad() { print line; exit }
        {
            line = $0
            sub(/^[ \t]+/, "", line); sub(/[ \t\r]+$/, "", line)
            if (block != "") {
                if (line == "</" block ">") block = ""
                else if (line ~ /^<\//) bad()
                next
            }
            if (length($0) >= 256) bad()
            if (line == "" || line ~ /^[#;]/) next
            if (line ~ /^<\/?connection>$/) next
            if (line ~ /^<[^\/]/) {
                tag = line; gsub(/^<|>$/, "", tag)
                if (!(tag in isdata) || line != "<" tag ">") bad()
                block = tag; next
            }
            n = split(line, w, /[ \t]+/); i = 1
            plain = w[1] !~ /^--/
            sub(/^--/, "", w[1])
            # `setenv opt X ...` is directive X, ignored if openvpn lacks it
            while (w[i] == "setenv" && w[i + 1] == "opt") { i += 2; plain = 0; sub(/^--/, "", w[i]) }
            if (!(w[i] in ok)) bad()
            if (w[i] == "remote" && !plain) bad()
            # a file argument root would read (auth-user-pass: sent to the server); inline blocks only
            if ((w[i] in isdata) && i < n) bad()
        }
        END { if (block != "") print "<" block "> not closed" }
    ' "$1"
}

wg_only() { [[ $1 == wg || $1 == awg ]] || die "$2 is for wg / awg profiles only"; }

# None of our providers tunnel IPv6; awg/wg-quick still add ::/0 policy routes
# when the profile lists them, which fails under disable_ipv6=1 (our leak guard).
wg_conf_strip_v6_allowedips() {
    awk '
    function strip_allowedips(line,    key, rest, n, i, tok, out, sep) {
        if (line !~ /^[[:space:]]*AllowedIPs[[:space:]]*=[[:space:]]*/) return line
        match(line, /^[[:space:]]*AllowedIPs[[:space:]]*=[[:space:]]*/)
        key = substr(line, 1, RLENGTH)
        rest = substr(line, RLENGTH + 1)
        n = split(rest, parts, ",")
        out = ""
        sep = ""
        for (i = 1; i <= n; i++) {
            tok = parts[i]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", tok)
            if (tok == "" || tok ~ /:/) continue
            out = out sep tok
            sep = ", "
        }
        if (out == "") return line
        return key out
    }
    /^[[:space:]]*AllowedIPs[[:space:]]*=/ { print strip_allowedips($0); next }
    { print }
    ' "$1"
}

# Briefly re-enable IPv6 globally for the up script when the guard had it off;
# strip IPv6 AllowedIPs so quick never needs working IPv6 on the tunnel device.
wg_quick_up() {
    local kind=$1 name=$2 conf dir bak ipv6_was_off=0 stripped=0 rc
    conf=$(need_conf "$kind" "$name")
    dir=$(dirname "$conf")
    bak="$dir/.$name.conf.omarchy-up"

    if grep -qE '^[[:space:]]*AllowedIPs[[:space:]]*=.*:' "$conf"; then
        cp -a "$conf" "$bak"
        wg_conf_strip_v6_allowedips "$bak" >"$conf"
        stripped=1
    fi

    restore_wg_conf() {
        [[ $stripped == 1 && -f $bak ]] || return 0
        mv -f "$bak" "$conf"
        stripped=0
    }
    trap restore_wg_conf EXIT

    if [[ $(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null || echo 0) == 1 ]]; then
        ipv6_was_off=1
        run sysctl -q -w net.ipv6.conf.all.disable_ipv6=0 net.ipv6.conf.default.disable_ipv6=0
    fi
    # a superseded switch can SIGKILL vpn_manager while awg/wg-quick is mid-up;
    # the half-created link stays and the next up dies with "already exists"
    if ip link show dev "$name" &>/dev/null; then
        run "$kind-quick" down "$name" 2>/dev/null || run ip link delete dev "$name"
    fi
    if run "$kind-quick" up "$name"; then
        restore_wg_conf
        trap - EXIT
        return 0
    fi
    rc=$?
    restore_wg_conf
    trap - EXIT
    if [[ $ipv6_was_off == 1 ]]; then
        run sysctl -q -w net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1 || true
    fi
    return "$rc"
}

cmd_up() {
    local conf
    conf=$(need_conf "$1" "$2")
    if [[ $1 == ovpn ]]; then
        run mkdir -p "$PID_DIR"
        # a ping-restart keeps the resolved server IP: under the kill switch
        # `remote` couldn't resolve again (DNS only through the tunnel)
        run openvpn --config "$conf" --daemon --writepid "$PID_DIR/client-$2.pid" \
            --script-security 2 --up "$DNS_UPDOWN up" --down "$DNS_UPDOWN down" \
            --persist-remote-ip
    else
        wg_quick_up "$1" "$2"
    fi
}

cmd_down() {
    if [[ $1 != ovpn ]]; then
        run "$1-quick" down "$2"
        return
    fi
    local pid_file=$PID_DIR/client-$2.pid pid comm
    [[ -f $pid_file ]] || die "not running: $2"
    pid=$(<"$pid_file")
    [[ $pid =~ ^[0-9]+$ ]] || die "bad PID file: $pid_file"
    # never `kill` just any PID: only the openvpn this profile started
    comm=$(cat "$PROC_DIR/$pid/comm" 2>/dev/null) || comm=""
    if [[ $comm != openvpn ]]; then
        run rm -f "$pid_file"  # stale: that process is gone (or the PID was reused)
        die "not running: $2"
    fi
    run kill "$pid"
    run rm -f "$pid_file"
}

cmd_import() {
    local dir
    dir=$(dir_of "$1")
    [[ -z $(conf_of "$1" "$2") ]] || die "a $1 profile named ${2@Q} already exists"
    [[ -d $dir ]] || die "no directory $dir"
    # global, not local: the EXIT trap runs after this function returns and
    # removes it — after the link below the profile lives on under its name
    tmp=$(mktemp "$dir/.import.XXXXXX")  # 0600 from the start: it holds keys
    trap 'rm -f "$tmp"' EXIT
    head -c $((MAX_IMPORT + 1)) >"$tmp"
    (($(stat -c %s "$tmp") <= MAX_IMPORT)) || die "config larger than 1 MiB"
    local unsafe
    unsafe=$(unsafe_line "$1" "$tmp")
    if [[ -n $unsafe && $1 == ovpn ]]; then
        die "this OpenVPN config has a directive the helper doesn't allow (${unsafe%% *}): it could run programs or read and write files as root; refusing to import. Remove that line, or copy it into $dir yourself with sudo if you trust it."
    elif [[ -n $unsafe ]]; then
        die "this config has PreUp/PostUp/PreDown/PostDown commands, which would run as root; refusing to import. Import it into NetworkManager instead (it drops them), or copy it into $dir yourself with sudo if you trust it."
    fi
    # a hard link fails if the name appeared meanwhile (two imports racing);
    # mv would silently replace the other one
    ln "$tmp" "$dir/$2.conf" 2>/dev/null || die "a $1 profile named ${2@Q} already exists"
}

cmd_rm() {
    local conf
    wg_only "$1" rm
    conf=$(need_conf "$1" "$2")
    run rm -f "$conf" "$SYSTEMD_DIR/$1-quick@$2.service.d/$DROPIN"
}

cmd_autostart() {
    wg_only "$1" autostart
    need_conf "$1" "$2" >/dev/null
    case ${3:-} in
        on)  run systemctl enable "$1-quick@$2" ;;
        off) run systemctl disable "$1-quick@$2" ;;
        *)   die "autostart takes on | off" ;;
    esac
}

cmd_endpoints() {
    local conf
    conf=$(need_conf "$1" "$2")
    # just what the ping and the kill switch whitelist need — never the keys
    if [[ $1 == ovpn ]]; then
        grep -Ei '^[[:space:]]*remote[[:space:]]' "$conf" || true
    else
        # section headers too: wg_endpoint() reads Endpoint only inside [Peer]
        grep -Ei '^[[:space:]]*(\[|Endpoint[[:space:]]*=)' "$conf" || true
    fi
}

# Profiles that got onto disk before the helper (the old rule let any process
# `cp` a config there) or by hand: `up` still runs their hooks, so say which.
cmd_audit() {
    local kind dir f unsafe
    for kind in wg awg ovpn; do
        dir=$(dir_of "$kind")
        for f in "$dir"/*.conf "$dir"/*.ovpn; do
            [[ -f $f ]] || continue
            [[ $kind != ovpn && $f == *.ovpn ]] && continue
            unsafe=$(unsafe_line "$kind" "$f")
            [[ -z $unsafe ]] || echo "$f: $unsafe"
        done
    done
}

# wg-quick@NAME starts at boot, before login — long before the bar's first
# --status turns IPv6 off. A drop-in turns it off right before the tunnel comes
# up, for every profile with autostart on (on), or for none (off: ⚙ IPv6 guard
# off). Never turned back on by systemd: another tunnel may be up by then; the
# plugin's disconnect does that. Drop-ins of deleted profiles go either way.
cmd_ipv6_boot() {
    [[ ${1:-} == on || ${1:-} == off ]] || die "ipv6-boot takes on | off"
    local kind dir conf name unit dropin
    for kind in wg awg; do
        dir=$(dir_of "$kind")
        for conf in "$dir"/*.conf; do
            [[ -f $conf ]] || continue
            name=$(basename "$conf" .conf)
            [[ $name =~ ^[A-Za-z0-9_][A-Za-z0-9_.=+-]{0,63}$ ]] || continue
            unit="$kind-quick@$name"
            dropin="$SYSTEMD_DIR/$unit.service.d/$DROPIN"
            if [[ $1 == on ]] && "$SYSTEMCTL" is-enabled --quiet "$unit" 2>/dev/null; then
                mkdir -p "${dropin%/*}"
                printf '%s\n' "# omarchy-vpn: IPv6 off before the tunnel (none of its providers tunnel IPv6)" \
                    "[Service]" \
                    "ExecStartPre=/usr/bin/sysctl -q -w net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1" \
                    >"$dropin"
            else
                rm -f "$dropin"
            fi
        done
    done
    for dropin in "$SYSTEMD_DIR"/{wg,awg}-quick@*.service.d/"$DROPIN"; do
        [[ -f $dropin ]] || continue
        unit=${dropin#"$SYSTEMD_DIR"/}
        unit=${unit%%.service.d/*}
        kind=${unit%%-quick@*}
        [[ -f $(dir_of "$kind")/${unit#*@}.conf ]] || rm -f "$dropin"
    done
    run "$SYSTEMCTL" daemon-reload
}

if [[ ${1:-} == ipv6-boot ]]; then
    cmd_ipv6_boot "${2:-}"
    exit 0
fi
if [[ ${1:-} == audit ]]; then
    cmd_audit
    exit 0
fi
(($# >= 3)) || die "usage: omarchy-vpn-helper up|down|import|rm|autostart|endpoints KIND NAME [on|off]"
verb=$1 kind=$2 name=$3
dir_of "$kind" >/dev/null
check_name "$name"
# a longer name isn't an interface name: wg-quick reads it as a path from root's cwd
# (rm never runs it, so profiles imported before the cap can still be deleted)
[[ $kind == ovpn || $verb == rm || ${#name} -le 15 ]] \
    || die "invalid profile name: ${name@Q} (WireGuard names are at most 15 characters)"
case $verb in
    up)        cmd_up "$kind" "$name" ;;
    down)      cmd_down "$kind" "$name" ;;
    import)    cmd_import "$kind" "$name" ;;
    rm)        cmd_rm "$kind" "$name" ;;
    autostart) cmd_autostart "$kind" "$name" "${4:-}" ;;
    endpoints) cmd_endpoints "$kind" "$name" ;;
    *)         die "unknown command: ${verb@Q}" ;;
esac
